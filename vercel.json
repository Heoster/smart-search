{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/search",        "dest": "/api/search.js" },
    { "src": "/api/scraper",       "dest": "/api/scraper.js" },
    { "src": "/api/synthesiser",   "dest": "/api/synthesiser.js" },
    { "src": "/api/llm-structurer","dest": "/api/llm-structurer.js" },
    { "src": "/api/unified",       "dest": "/api/unified.js" },
    { "src": "/(.*)",              "dest": "/public/$1" }
  ],
  "functions": {
    "api/unified.js":       { "maxDuration": 60 },
    "api/synthesiser.js":   { "maxDuration": 30 },
    "api/llm-structurer.js":{ "maxDuration": 30 },
    "api/scraper.js":       { "maxDuration": 15 },
    "api/search.js":        { "maxDuration": 20 }
  }
}